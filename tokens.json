{
  "$description": "Shazaar design tokens. Mirrors src/styles/tokens.css (a unit test keeps them in sync). Consumed later by the mobile app.",
  "color": {
    "canvas": "#FAF6EF",
    "surface": "#FEFCF8",
    "sunk": "#F1ECE4",
    "ink": "#1B1410",
    "ink-muted": "#5C534E",
    "on-ink": "#FDFAF3",
    "gold": "#B26F06",
    "gold-deep": "#934400",
    "gold-soft": "#F2DBB1",
    "gold-logo": "#C17F25",
    "line": "#E4DDD3",
    "line-strong": "#8C827B",
    "success": "#007A55",
    "error": "#B3261E",
    "scrim": "#0E0B08"
  },
  "radius": {
    "sharp": "2px",
    "soft": "8px",
    "card": "16px"
  },
  "shadow": {
    "raise": "0 1px 2px rgb(27 20 16 / 0.06), 0 12px 32px -16px rgb(27 20 16 / 0.22)",
    "float": "0 32px 64px -24px rgb(14 11 8 / 0.45)"
  },
  "font": {
    "display": "Fraunces",
    "sans": "Manrope",
    "display-ar": "Amiri",
    "sans-ar": "IBM Plex Sans Arabic"
  },
  "motion": {
    "ease-out": "cubic-bezier(0.22, 0.61, 0.36, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "duration-ui": "200ms",
    "duration-reveal": "700ms",
    "duration-fade": "1200ms",
    "hero-dwell": "6000ms"
  },
  "layout": {
    "page-max": "1440px",
    "gutter": "16px"
  }
}
