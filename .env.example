# Copy to .env.local and fill in. Never commit real values.

# Public site URL (canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data source for listings: "mock" until the backend phase
NEXT_PUBLIC_DATA_SOURCE=mock

# Supabase (Phase B)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (Phase B)
RESEND_API_KEY=
EMAIL_FROM=

# Rate limiting (Phase B)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bot protection (Phase B)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics: left empty until the measurement ID is confirmed (consent mode required)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
